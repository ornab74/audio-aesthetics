# Defaults to 127.0.0.1 (local only); to deploy publicly use reverse proxy HTTPS/WSS and auth.
AESTHETICS_HOST=127.0.0.1
AESTHETICS_PORT=8788
AESTHETICS_ACCESS_TOKEN=
AESTHETICS_OSC_PORT=9000
# AI is OFF by default; choose local or cloud from Flutter client.
CLEF_LOCAL_URL=http://127.0.0.1:8088/v1/systemone
CLEF_LOCAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hosted billing: create $20/month recurring price in Stripe dashboard and copy its price ID.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8788
AESTHETICS_DB=./aesthetics_billing.sqlite3
# Hosted cloud mode is gated by paid Pro token; local mode is always free.
